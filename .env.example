VITE_API_BASE_URL=http://127.0.0.1:4000/api/v1
# Google Maps JavaScript API — "prila-admin-web" key (restricted to the admin domain + localhost).
# This key ships in the browser bundle by design; its website restriction is what protects it.
VITE_GOOGLE_MAPS_KEY=
# Map ID (vector map + Advanced Markers) — Cloud Console → Map Management → prila-admin-map
VITE_GOOGLE_MAP_ID=
